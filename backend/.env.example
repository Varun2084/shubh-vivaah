# CareerAtlas backend configuration.
# Copy to .env and fill in keys. Any service left blank runs in mock mode.

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Groq — LLM reasoning for every agent
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — text embeddings
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Tavily — web search for roadmap grounding
TAVILY_API_KEY=

# Pinecone — vector store for job matching
PINECONE_API_KEY=
PINECONE_INDEX=careeratlas-jobs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Supabase — persistence of analysis runs
SUPABASE_URL=
SUPABASE_KEY=
